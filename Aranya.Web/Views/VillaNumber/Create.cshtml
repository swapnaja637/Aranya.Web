@model VMVillaNumber
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header bg-success text-center text-white">
                    <h1>Create New Villa Number</h1>
                </div>
                <div class="card-body">
                    <div class="col-12 text-end p-1 mb-2">
                        <a asp-action="Index" asp-controller="VillaNumber" class="btn btn-dark">Back to Villa Number <i class="bi bi-arrow-return-left"></i></a>
                    </div>
                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-3">
                                <label asp-for="villaNumber.VillaID" class="form-label text-black"></label>
                            </div>
                            <div class="col-lg-9">
                               @*VIEWDATA STORED THE DATA AS KEY,VALUE PAIR VIEWDATA<STRING,OBJECT> SO,the value is stored in objecct and hene we need to convert it.
                                   But in ViewBag is dynamic ,compiler doesn't check its type,t runtime asp.net core figure out the atual object .and henc
                                   it doens neeed casting.' *@
                           @*    <select asp-for = "@Model.VillaID"  asp-items = "@ViewData["Villalist"] as IEnumerable<SelectListItem>"
                                  class="form-control">
                              <option value="0">Select Villa</option>    
                              </select> *@
                                <select asp-for="@Model.villaNumber.VillaID" asp-items="@Model.villaList"
                                        class="form-control">
                                    <option value="0">Select Villa</option>
                                </select>
                                <span asp-validation-for="villaNumber.VillaID" class="alert-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-3">
                                <label asp-for="villaNumber.SpecialDetails" class="form-label text-black"></label>
                            </div>
                            <div class="col-lg-9">
                                <input asp-for="villaNumber.SpecialDetails" class="form-control" />
                                <span asp-validation-for="villaNumber.SpecialDetails" class="alert-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-3">
                                <label asp-for="villaNumber.Villa_Number" class="form-label text-black"></label>
                            </div>
                            <div class="col-lg-9">
                                <input asp-for="villaNumber.Villa_Number" class="form-control" />
                                <span asp-validation-for="villaNumber.Villa_Number" class="alert-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 text-center border p-3">
                            <button type="submit" class="btn btn-success" title="Update">Save <i class="bi bi-plus-circle"></i></button>
                            <button type="reset" class="btn btn-danger">Clear <i class="bi bi-x-circle"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>